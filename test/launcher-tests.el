;;; launcher-tests.el --- Dynamic launcher input regressions -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'launcher-test-support)

(defconst launcher-test--apps
  '(("Calculator" . "/Applications/Calculator.app")
    ("Activity Monitor" . "/Applications/Activity Monitor.app")))

(defun launcher-test--run (choice &optional space-binding refresh)
  "Run launcher with CHOICE, recording actions and the Space binding."
  (let* ((launcher--apps launcher-test--apps) (launcher-show-icons nil)
         (launcher-tools launcher-test--search-tools) (minibuffer-setup-hook nil)
         (base-reader (launcher-test--reader (list choice)))
         launched searched observed-space refreshed outcome
         (completing-read-function
          (lambda (&rest args)
            (minibuffer-with-setup-hook
                (lambda ()
                  (when space-binding
                    (let ((map (make-sparse-keymap)))
                      (set-keymap-parent map (current-local-map))
                      (define-key map " " space-binding)
                      (use-local-map map)))
                  (setq observed-space (key-binding " ")))
              (apply base-reader args)))))
    (cl-letf (((symbol-function 'launcher--launch) (lambda (path) (push path launched)))
              ((symbol-function 'browse-url) (lambda (url &rest _) (push url searched)))
              ((symbol-function 'launcher-refresh) (lambda () (setq refreshed t))))
      (setq outcome (condition-case nil (progn (launcher refresh) 'accepted)
                      (quit 'quit) (error 'error))))
    (list :outcome outcome :launched launched :searched searched
          :space observed-space :refreshed refreshed)))

(ert-deftest launcher-empty-input-cancels ()
  (dolist (input '("" " " " \t\n"))
    (let ((result (launcher-test--run input)))
      (should (eq (plist-get result :outcome) 'quit))
      (should-not (plist-get result :launched))
      (should-not (plist-get result :searched)))))

(ert-deftest launcher-accepts-selected-application ()
  (let ((result (launcher-test--run "calc")))
    (should (eq (plist-get result :outcome) 'accepted))
    (should (equal (plist-get result :launched) '("/Applications/Calculator.app")))
    (should-not (plist-get result :searched))))

(ert-deftest launcher-search-tool-search-preserves-query ()
  (let* ((query "portal launcher & 中文")
         (result (launcher-test--run (concat "gh " query))))
    (should (equal (plist-get result :searched)
                   (list (concat "https://github.com/search?q=" (url-hexify-string query)))))))

(ert-deftest launcher-search-tool-entry-inserts-prefix-and-empty-query-stays-in-tool ()
  (let* ((session (launcher--query-create
                   nil (let ((launcher-tools launcher-test--search-tools))
                         (launcher--tools))))
         (launcher--query-session session))
    (unwind-protect
        (progn
          (launcher--query-update session "gh")
          (should (equal (launcher--result-execute (car (launcher--query-session-results session)))
                         '(:input "gh ")))
          (dolist (input '("gh " "gh \t "))
            (launcher--query-update session input)
            (should (launcher--query-session-route session))
            (let ((results (launcher--query-session-results session)))
              (should (= 1 (length results)))
              (should (eq 'prefix-entry (plist-get (car results) :id)))
              (should (equal (launcher--result-execute (car results))
                             (list :input input))))))
      (launcher--query-close session))))

(ert-deftest launcher-web-fallback-only-without-results ()
  (let* ((session (launcher--query-create
                   launcher-test--apps
                   (let ((launcher-tools launcher-test--search-tools))
                     (launcher--tools))))
         (launcher--query-session session))
    (unwind-protect
        (progn
          (dolist (input '("calc" "1+2" "gh" "gh emacs"))
            (launcher--query-update session input)
            (should (launcher--query-session-results session))
            (should-not (seq-find (lambda (r) (eq (plist-get r :id) 'fallback))
                                  (launcher--query-session-results session))))
          (launcher--query-update session "no matching apps")
          (should (= 1 (length (launcher--query-session-results session))))
          (should (eq 'fallback (plist-get (car (launcher--query-session-results session)) :id)))
          (should-not (launcher--query-session-route session)))
      (launcher--query-close session))))

(ert-deftest launcher-app-results-capture-distinct-paths ()
  (let* ((session (launcher--query-create
                   '(("Calculator" . "/Applications/Calculator.app")
                     ("Calendar" . "/Applications/Calendar.app")) nil))
         (launcher--query-session session) launched)
    (launcher--query-update session "cal")
    (cl-letf (((symbol-function 'launcher--launch) (lambda (path) (push path launched))))
      (dolist (result (launcher--query-session-results session))
        (launcher--result-execute result)))
    (should (equal '("/Applications/Calendar.app" "/Applications/Calculator.app") launched))
    (launcher--query-close session)))

(ert-deftest launcher-unmatched-input-searches ()
  (let ((launcher-fallback-search-url "https://example.com/?q=%s"))
    (dolist (input '("some words" "!unknown" "example.com" "example.com/path"
                    "ftp://example.com" "see https://example.com"))
      (should (equal (plist-get (launcher--fallback-result input) :title)
                     (concat "Search web: " input)))
      (should (equal (plist-get (launcher-test--run input) :searched)
                     (list (concat "https://example.com/?q=" (url-hexify-string input))))))))

(ert-deftest launcher-url-fallback-opens-input-unchanged ()
  (let ((case-fold-search nil)
        (launcher-fallback-search-url "https://search.example/?q=%s"))
    (dolist (input '("http://example.com" "https://example.com"
                    "HTTP://example.com" "HtTpS://example.com"
                    "https://example.com/path?q=hello%20world&lang=中文#section"
                    "https://"))
      (let ((result (launcher--fallback-result input)))
        (should (eq (plist-get result :id) 'fallback))
        (should (equal (plist-get result :title) (concat "Open URL: " input))))
      (should (equal (plist-get (launcher-test--run input) :searched) (list input))))))

(ert-deftest launcher-search-tool-url-input-still-searches ()
  (let* ((query "https://example.com/path?q=emacs#section")
         (result (launcher-test--run (concat "gh " query))))
    (should (equal (plist-get result :searched)
                   (list (concat "https://github.com/search?q=" (url-hexify-string query)))))))

(ert-deftest launcher-custom-space-binding-is-preserved ()
  (should (eq #'ignore (plist-get (launcher-test--run "calc" #'ignore) :space))))

(ert-deftest launcher-refresh-only-on-request ()
  (should-not (plist-get (launcher-test--run "calc") :refreshed))
  (should (plist-get (launcher-test--run "calc" nil '(4)) :refreshed)))

(ert-deftest launcher-empty-index-refreshes-once-per-invocation ()
  (dolist (refresh '(nil t))
    (let ((launcher--apps nil) (calls 0))
      (cl-letf (((symbol-function 'launcher-refresh) (lambda () (cl-incf calls))))
        (should-not (launcher--entries refresh))
        (should (= calls 1))))))

(ert-deftest launcher-app-entries-sort-and-preserve-plain-names ()
  (let ((paths '("/Applications/Notes.app" "/Applications/Calculator.app/"
                 "/System/Applications/Notes.app")))
    (should (equal (launcher--build-entries paths)
                   '(("Calculator" . "/Applications/Calculator.app/")
                     ("Notes" . "/Applications/Notes.app")
                     ("Notes" . "/System/Applications/Notes.app"))))
    (should (equal paths '("/Applications/Notes.app" "/Applications/Calculator.app/"
                          "/System/Applications/Notes.app")))))

(ert-deftest launcher-same-name-apps-use-path-subtitles-and-launch-distinctly ()
  (let* ((paths '("/Applications/Notes.app" "/System/Applications/Notes.app"))
         (launcher-show-icons nil)
         launched)
    (launcher-test--with-session (launcher--build-entries paths) nil
      (launcher--query-update session "notes")
      (let ((results (launcher--query-session-results session)))
        (should (equal (mapcar (lambda (result) (plist-get result :title)) results)
                       '("Notes" "Notes")))
        (should (equal (mapcar (lambda (result) (plist-get result :id)) results)
                       paths))
        (should (equal (mapcar (lambda (result) (plist-get result :subtitle)) results)
                       paths))
        (should-not (equal (plist-get (car results) :candidate)
                           (plist-get (cadr results) :candidate)))
        (cl-letf (((symbol-function 'launcher--launch)
                   (lambda (path) (push path launched))))
          (dolist (result results)
            (should (eq result (launcher--result-for-candidate
                               (substring-no-properties (plist-get result :candidate)))))
            (launcher--result-execute result)))
        (should (equal (nreverse launched) paths))))))

(ert-deftest launcher-reader-quit-and-error-clean-up ()
  (dolist (condition '(quit error))
    (let ((minibuffer-setup-hook nil))
      (should (eq (plist-get (launcher-test--run condition) :outcome) condition))
      (should-not minibuffer-setup-hook))))

(ert-deftest launcher-no-raw-text-dispatch ()
  (let ((launcher--apps launcher-test--apps) opened
        (completing-read-function (lambda (&rest _) "Calculator")))
    (cl-letf (((symbol-function 'launcher--launch) (lambda (_) (setq opened t)))
              ((symbol-function 'browse-url) (lambda (&rest _) (setq opened t))))
      (should (eq 'quit (condition-case nil (launcher) (quit 'quit))))
      (should-not opened))))

(ert-deftest launcher-discovery-routing-and-deduplication ()
  (let (calls)
    (cl-letf (((symbol-function 'launcher--collect-paths-spotlight)
               (lambda () (push 'spotlight calls)
                 '("/Applications/A.app" "/Applications/A.app")))
              ((symbol-function 'launcher--collect-paths-filesystem)
               (lambda () (push 'filesystem calls)
                 '("/Applications/A.app" "/Applications/B.app"))))
      (dolist (method '(spotlight filesystem))
        (let ((launcher-app-discovery-method method))
          (setq calls nil)
          (should (equal (launcher--collect-paths)
                         (if (eq method 'spotlight)
                             '("/Applications/A.app")
                           '("/Applications/A.app" "/Applications/B.app"))))
          (should (equal calls (list method)))))
      (let ((launcher-app-discovery-method 'invalid))
        (should-error (launcher--collect-paths) :type 'user-error)))))

(ert-deftest launcher-discovery-filesystem-boundaries ()
  (let* ((root (make-temp-file "launcher-discovery-" t))
         (launcher-app-discovery-method 'filesystem)
         (launcher-app-directories
          (list (expand-file-name "apps" root)
                (expand-file-name "apps/Utilities" root)
                (expand-file-name "missing" root)
                (expand-file-name "linked-root" root))))
    (unwind-protect
        (progn
          (dolist (dir '("apps/Main.app/Contents/Helper.app"
                         "apps/Utilities/工具.app" "external/Other.app"))
            (make-directory (expand-file-name dir root) t))
          (write-region "not a bundle" nil (expand-file-name "apps/File.app" root)
                        nil 'silent)
          (make-symbolic-link (expand-file-name "external" root)
                              (expand-file-name "apps/external-link" root))
          (make-symbolic-link (expand-file-name "apps" root)
                              (expand-file-name "apps/cycle" root))
          (make-symbolic-link (expand-file-name "external/Other.app" root)
                              (expand-file-name "apps/Alias.app" root))
          (make-symbolic-link (expand-file-name "missing.app" root)
                              (expand-file-name "apps/Broken.app" root))
          (make-symbolic-link (expand-file-name "external" root)
                              (expand-file-name "linked-root" root))
          (cl-letf (((symbol-function 'executable-find)
                     (lambda (&rest _) (ert-fail "Filesystem must not check mdfind")))
                    ((symbol-function 'process-lines)
                     (lambda (&rest _) (ert-fail "Filesystem must not run mdfind"))))
            (should (equal (sort (launcher--collect-paths) #'string-lessp)
                           (sort (mapcar (lambda (path) (expand-file-name path root))
                                         '("apps/Main.app" "apps/Utilities/工具.app"
                                           "apps/Alias.app" "linked-root/Other.app"))
                                 #'string-lessp)))))
      (delete-directory root t))))

(ert-deftest launcher-discovery-unreadable-directory ()
  ;; Simulate permission failure: chmod is unreliable under privileged users.
  (let* ((root (make-temp-file "launcher-unreadable-" t))
         (blocked (expand-file-name "blocked" root))
         (app (expand-file-name "Good.app" root))
         (launcher-app-directories (list root))
         (launcher-app-discovery-method 'filesystem)
         (original (symbol-function 'directory-files)) messages)
    (unwind-protect
        (progn
          (make-directory blocked)
          (make-directory app)
          (cl-letf (((symbol-function 'directory-files)
                     (lambda (dir &rest args)
                       (if (equal dir blocked)
                           (signal 'file-error '("Permission denied"))
                         (apply original dir args))))
                    ((symbol-function 'message)
                     (lambda (format-string &rest args)
                       (push (apply #'format format-string args) messages))))
            (should (equal (launcher--collect-paths) (list app)))
            (should (seq-some (lambda (message)
                                (string-match-p "Permission denied" message))
                              messages))))
      (delete-directory root t))))

(ert-deftest launcher-discovery-spotlight-query-and-filter ()
  (let* ((root (make-temp-file "launcher-spotlight-" t))
         (app (expand-file-name "A.app" root))
         (launcher-app-directories (list root (expand-file-name "missing" root)))
         (launcher-app-discovery-method 'spotlight)
         (launcher-mdfind-query "custom query") calls)
    (unwind-protect
        (progn
          (make-directory app)
          (cl-letf (((symbol-function 'executable-find) (lambda (_) t))
                    ((symbol-function 'process-lines)
                     (lambda (&rest args)
                       (push args calls)
                       (list app app root (expand-file-name "Gone.app" root)))))
            (should (equal (launcher--collect-paths) (list app)))
            (should (equal calls (list (list "mdfind" "-onlyin" root "custom query"))))))
      (delete-directory root t))))

(ert-deftest launcher-discovery-session-cache-and-refresh ()
  (let ((launcher--apps nil)
        (launcher-app-discovery-method 'spotlight) calls icons)
    (cl-letf (((symbol-function 'launcher--collect-paths-spotlight)
               (lambda () (push 'spotlight calls) '("/Applications/A.app")))
              ((symbol-function 'launcher--collect-paths-filesystem)
               (lambda () (push 'filesystem calls) '("/Applications/B.app")))
              ((symbol-function 'launcher-icons-index-refreshed)
               (lambda (paths) (push paths icons))))
      (should (equal (launcher--entries nil) '(("A" . "/Applications/A.app"))))
      (setq launcher-app-discovery-method 'filesystem)
      (should (equal (launcher--entries nil) '(("A" . "/Applications/A.app"))))
      (should (equal calls '(spotlight)))
      (should (equal (launcher--entries t) '(("B" . "/Applications/B.app"))))
      (should (equal calls '(filesystem spotlight)))
      (should (equal icons '(("/Applications/B.app") ("/Applications/A.app")))))))

(provide 'launcher-tests)
;;; launcher-tests.el ends here
